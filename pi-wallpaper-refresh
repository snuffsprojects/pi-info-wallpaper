#!/usr/bin/env bash
set -euo pipefail

config_file="${XDG_CONFIG_HOME:-$HOME/.config}/pi-wallpaper/config"
role="Raspberry Pi"
colour="#000000"
width="1920"
height="1080"
accent="#ffad42"
position="bottom-left"
generate_only=0

if [[ -f "$config_file" ]]; then
  # Config is generated by the installer and restricted to these assignments.
  while IFS='=' read -r key value; do
    case "$key" in
      ROLE) role="$value" ;;
      COLOUR) colour="$value" ;;
      WIDTH) width="$value" ;;
      HEIGHT) height="$value" ;;
      ACCENT) accent="$value" ;;
      POSITION) position="$value" ;;
      GENERATE_ONLY) generate_only="$value" ;;
    esac
  done < "$config_file"
fi

install_dir="${XDG_DATA_HOME:-$HOME/.local/share}/pi-wallpaper"
wallpaper="$install_dir/wallpaper.svg"
"$install_dir/pi-wallpaper.py" --role "$role" --colour "$colour" --accent "$accent" --position "$position" --width "$width" --height "$height" --output "$wallpaper"

if [[ "$generate_only" == "1" ]]; then
  printf 'Pi wallpaper generated: %s\n' "$wallpaper"
  exit 0
fi

applied=0
if command -v pcmanfm >/dev/null 2>&1; then
  pcmanfm --set-wallpaper="$wallpaper" --wallpaper-mode=fit >/dev/null 2>&1 && applied=1 || true
fi
if [[ $applied -eq 0 ]] && command -v pcmanfm-qt >/dev/null 2>&1; then
  pcmanfm-qt --set-wallpaper="$wallpaper" --wallpaper-mode=fit >/dev/null 2>&1 && applied=1 || true
fi
if [[ $applied -eq 0 ]] && command -v xfconf-query >/dev/null 2>&1; then
  while read -r property; do
    xfconf-query -c xfce4-desktop -p "$property" -s "$wallpaper" >/dev/null 2>&1 || true
  done < <(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E 'last-image|image-path' || true)
  applied=1
fi
if [[ $applied -eq 0 ]] && command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.background picture-uri "file://$wallpaper" >/dev/null 2>&1 || true
  gsettings set org.gnome.desktop.background picture-uri-dark "file://$wallpaper" >/dev/null 2>&1 || true
  applied=1
fi

if [[ $applied -eq 0 ]]; then
  printf 'Wallpaper generated at %s, but no supported desktop setter was detected.\n' "$wallpaper" >&2
  exit 2
fi
printf 'Pi Info Wallpaper refreshed: %s\n' "$wallpaper"
